# Copy to .env.local for `npm run dev`, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# ── AI advisor (server-side, never exposed to the browser) ───────────────────
# Free key: https://aistudio.google.com/apikey  (Gemini free tier)
AI_API_KEY=
# Optional: switch to any OpenAI-compatible provider
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
# AI_FREE_PER_DAY=2          # per browser
# AI_IP_PER_DAY=30           # free requests per IP, all browsers together
# AI_PRO_PER_DAY=120

# ── Shared daily AI limits (Redis) ────────────────────────────────────────────
# Vercel → Storage → Create Database → Upstash Redis (successor of Vercel KV)
# → Connect to this project: these two are then added automatically.
# Without them the limits are kept in memory per server instance.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ── Pro licenses ──────────────────────────────────────────────────────────────
LICENSE_PROVIDER=lemonsqueezy        # or: gumroad
# LEMONSQUEEZY_STORE_ID=
# GUMROAD_PRODUCT_ID=
# Keys that always unlock Pro (testing, giveaways, partners)
# PRO_DEMO_KEYS=

# ── Checkout links shown on /pro (public) ────────────────────────────────────
VITE_CHECKOUT_URL_MONTHLY=
VITE_CHECKOUT_URL_LIFETIME=

# ── AdSense (public) ─────────────────────────────────────────────────────────
# Simplest: create ONE responsive "Display ad" unit and put its ID here —
# every placement without its own ID uses it.
VITE_AD_SLOT_DEFAULT=
# VITE_ADSENSE_CLIENT=ca-pub-7094672848897049
VITE_AD_SLOT_CALCULATOR=
VITE_AD_SLOT_SCHEDULE=
VITE_AD_SLOT_EARLY=
VITE_AD_SLOT_OFFERS=
VITE_AD_SLOT_SAVED=
VITE_AD_SLOT_LANDING=
VITE_AD_SLOT_TOP=
VITE_AD_SLOT_BOTTOM=
VITE_AD_SLOT_COMPARE=
VITE_AD_SLOT_RAIL=

# Pro is "coming soon" until this is true (opens trial + checkout)
# VITE_PRO_ENABLED=true

# ── Site ──────────────────────────────────────────────────────────────────────
# Canonical URL for SEO, sitemap and the widget code (set when you get a domain)
# VITE_SITE_URL=https://www.armfincredit.site

# ── Requests to banks (/api/lead) ─────────────────────────────────────────────
# Requests are stored in Redis (above) under "afc:leads". To also get each one
# by email: sign up at resend.com with the contact address, create an API key.
# RESEND_API_KEY=
# LEAD_EMAIL_TO=armfincredit@zohomail.com
# LEAD_EMAIL_FROM=ArmFinCredit <onboarding@resend.dev>
# LEAD_PER_DAY=5               # requests per IP per day

# Contact address shown on the site (footer, partner page, forms)
# VITE_CONTACT_EMAIL=armfincredit@zohomail.com
